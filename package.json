{
  "name": "schematics-ds-migration",
  "version": "0.1.0",
  "description": "Schematics Angular pour migrer une application d'un design system vers un autre (Lion -> DSFR / ngx-dsfr, ...)",
  "keywords": [
    "schematics",
    "angular",
    "design-system",
    "migration",
    "lion",
    "dsfr",
    "ngx-dsfr"
  ],
  "license": "MIT",
  "schematics": "./src/collection.json",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "docs": "npm run build && node src/tools/generate-docs.js",
    "example": "npm run build && node scripts/run-example.mjs"
  },
  "dependencies": {
    "@angular-devkit/core": "~19.2.15",
    "@angular-devkit/schematics": "~19.2.15",
    "@schematics/angular": "~19.2.15",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@angular-devkit/schematics-cli": "~19.2.15",
    "@types/node": "^24.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@angular/cli": ">=19.0.0 <=19.2.15"
  },
  "peerDependenciesMeta": {
    "@angular/cli": {
      "optional": true
    }
  }
}
